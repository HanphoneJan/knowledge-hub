# Personal Knowledge Hub — 基础设施配置
# 复制为 .env 后按需修改；.env 已被 gitignore
#
# 代理说明：拉 Docker 镜像若走本地代理（Clash/mihomo 等，常见端口 7890），需显式配置。
# Docker daemon 本身不读 shell 的 HTTP_PROXY，需配置 systemd 或在
# `docker pull` 前 export 后用 `docker compose build`。
# 参考：DEPLOY-RUNBOOK.md

# ---------- Postgres ----------
POSTGRES_USER=pkh
POSTGRES_PASSWORD=pkh_local_dev
POSTGRES_DB=pkh

# ---------- Qdrant ----------
QDRANT_URL=http://127.0.0.1:6333

# ---------- 模型（D22：全局统一，改动需全量重建索引）----------
TEXT_EMBED_MODEL=BAAI/bge-small-zh-v1.5
TEXT_EMBED_DIM=512
VDR_MODEL=vidore/colSmol-500M
# D158：视觉查询服务（**只做编码**，文本 → multi-vectors）。
# 🔴 它**没有鉴权** —— 所以默认只绑 127.0.0.1，`deploy/dev.sh` 就是这么起的。
# ⚠️ 关掉读侧的方式是**把它留空**（检索照常，只是视觉腿恒 skipped）：
#   2C4G 这类小机器上它那 2.65GB 常驻会直接 OOM（CONVENTIONS §4.1b）。
#   写入侧不受影响 —— worker 仍本地编码图片（15s/图）。
VISUAL_SERVICE_URL=http://127.0.0.1:8020
# 🔑 2s = 6 路并发时单条编码 p95 905ms 的**两倍余量**，且**包含排队**。
VISUAL_SERVICE_TIMEOUT_S=2.0
# ⚠️ 别往上调：colSmol 在 CPU 上并行度 8.7x（6 路并发吃 8.7 个核）。
#   超限就在客户端排队，排队超时就降级成 skipped。
VISUAL_SERVICE_MAX_CONCURRENCY=4
# 🔑 D178：把**写侧**（worker 编码图片）也交给上面那个常驻服务 ⇒ worker
#   不再自己加载 colSmol（2.65GB/进程）。SMB 多 worker 必须开它，
#   否则 `PKH_WORKERS=4` 就是 4 × 2.65GB ≈ +10.6GB。
# ⚠️ 打开后**摄取依赖视觉服务**：它挂了，照片/扫描件摄取会失败并重试。
# 默认 false = 保持既有行为（worker 本地编码）。
VISUAL_WRITE_VIA_SERVICE=false
# 写侧**单页**图片编码超时（秒）。一页 colSmol 前向实测 ~15s，加上排队给足余量。
VISUAL_SERVICE_IMAGE_TIMEOUT_S=120.0

# ---------- trgm 腿的规模闸（D180）----------
# trgm 的召回条件是 word_similarity()，只能 seq scan（D70）：实测 10 万 chunk ≈ 1.4s、
# 100 万 ≈ 13.9s，远超检索 500ms 预算 ⇒ 超过下面这个毫秒数就降级成 skipped（如实说明）。
# 0 = 不限（库很小、或想量全量耗时的场景）。
TRGM_STATEMENT_TIMEOUT_MS=800

# ---------- 运行时 ----------
PKH_API_ENV=local
LOG_LEVEL=INFO
# 数据目录（相对项目根）
PKH_DATA_DIR=data

# ---------- 运维（阶段 7）----------
# 🔑 巡检专用 API Key（deploy/monitor.py 用）。
#
# ⚠️ **必须是注册过的 Key**：注册接口返回的 `api_key` 只在那一刻出现一次，
#   之后查不到。所以下面这条在填之前是**空的**：
#
#   curl -sX POST http://127.0.0.1:8010/api/v1/auth/register \
#     -H 'Content-Type: application/json' \
#     -d '{"email":"ops@example.com","password":"<强密码>","display_name":"运维"}'
#
# ⚠️ 不要把 `PKH_API_KEY` 拿来做这件事：那个键在开发环境里是个**约定值**，
#   库里并没有对应的记录 —— 巡检拿它调 /health 会 401，
#   而巡检会把这显示成"跳过"（不是失败），因为那是**它自己没配好**，
#   与服务健康无关（见 `deploy/monitor.py` 的三态设计）。
# ===== 隐私：归属判定的名字表 =====
# 判定「这份文档是谁的」用的名单。**真实姓名不要写进代码/仓库**，写在这里（.env 不进 git）。
# 留空 = 用代码里的占位名（`张三`/`李四`…）。逗号分隔；中英文逗号都认。
PRIVACY_SELF_NAMES=
PRIVACY_OTHER_NAMES=

# ===== 演示 / 开发账号（deploy/seed_photos.py 用）=====
# ⚠️ 生产请自己设，别沿用示例邮箱；密码留空则该脚本拒绝运行。
SEED_DEV_PASSWORD=
KEEPER_EMAIL=photos@keeper.local
KEEPER_PASSWORD=

PKH_MONITOR_KEY=

# D152：持久照片库专用账号的 Key（photos@keeper.pkh）。它的 kb_visual 点
# 每轮基线都不会被清（eval 只清 @t.local、e2e 只清 1e-/1f-/1g- 前缀）。
# 用 `uv run python deploy/seed_photos.py` 造，明文只显示一次。
PKH_KEEPER_KEY=

# 备份输出目录（默认 ${PKH_DATA_DIR}/backups）
#PKH_BACKUP_DIR=data/backups
# 巡检 API 地址（默认 http://127.0.0.1:8010）
#PKH_API_URL=http://127.0.0.1:8010
# Postgres 容器名（脚本要 `docker exec` 进去查）
#PG_CONTAINER=pkh-postgres

# ---------- 对外暴露面（D138）----------
# ⚠️ 默认**开着**（本机开发与整套基线都要用）。对外部署时改成 false：
#   ALLOW_REGISTER=false  → 关掉自助注册（只对公网关；本机脚本仍可用）
#   EXPOSE_DOCS=false     → 关掉 /docs 与 /openapi.json
#   详见 docs/REQUIREMENTS.md 的 D138 与 DEPLOY-RUNBOOK.md「对外访问」。
ALLOW_REGISTER=true
EXPOSE_DOCS=true

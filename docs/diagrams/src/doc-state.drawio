</mxCell><mxCell id="c14" value="重试耗尽" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;labelBackgroundColor=#ffffff;dashed=1;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="视觉点不够且无待办" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;labelBackgroundColor=#ffffff;dashed=1;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="纯扫描件 / 照片：ingest 结束是 pending（已派发每页视觉任务）；页级点齐了由 doc_state 翻 ready。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="440" height="90" as="geometry"/></mxCell><mxCell id="c17" value="VDR_ENABLED=false：没有视觉待办，直接 ready。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="440" height="45" as="geometry"/></mxCell><mxCell id="c18" value="decide_doc_state：三件事都算" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#666666;container=1;collapsible=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="100" width="540" height="320" as="geometry"/></mxCell><mxCell id="c19" value="① 文档还在中间态吗？&lt;br&gt;终态（含 failed）不动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c18"><mxGeometry x="20" y="45" width="500" height="55" as="geometry"/></mxCell><mxCell id="c20" value="② 还有未完成的 ingest / embed_visual 吗？&lt;br&gt;有就还没到终态；thumbnail / pdf_preview 不挡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c18"><mxGeometry x="20" y="115" width="500" height="75" as="geometry"/></mxCell><mxCell id="c21" value="③ 该有的页级点齐了吗？&lt;br&gt;scan_pages 非空时，kb_visual 点数 ≥ 页数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c18"><mxGeometry x="20" y="205" width="500" height="75" as="geometry"/></mxCell><mxCell id="c22" value="结论：ready（点齐） / failed（摄取失败或点不够且无待办）&lt;br&gt;scan_pages=NULL 的老文档只在视觉任务全失败时判 failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="460" width="540" height="90" as="geometry"/></mxCell><mxCell id="c23" value="启动补扫 sweep_stuck_docs&lt;br&gt;&lt;br&gt;中间态却没有任何待办任务 = 那个 pending 承诺没人能兑现。worker 在 finish_job 之后、结算提交之前被杀会留下这种文档。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="590" width="540" height="120" as="geometry"/></mxCell><mxCell id="c24" value="任务终态由 finish_job 写；文档终态由 settle_doc_state 在成功与失败两条路径都调。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="500" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
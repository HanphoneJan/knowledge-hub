<mxfile host="app.diagrams.net">
  <diagram id="jobstate" name="job-state">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="880" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="jobLabel" value="任务状态（jobs.status）" style="fillColor=#f5f5f5;text;html=1;fontStyle=1;fontColor=#333333;fontFamily=Noto Sans CJK SC;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="pending" value="pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="110" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="running" value="running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="220" y="70" width="110" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="done" value="done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="410" y="30" width="110" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="failed" value="failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="410" y="110" width="110" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cancelled" value="cancelled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="220" y="170" width="110" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="领取" style="labelBackgroundColor=#f5f5f5;endArrow=block;html=1;strokeColor=#666666;fontColor=#333333;fontFamily=Noto Sans CJK SC;fontSize=10;" edge="1" parent="1" source="pending" target="running"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="finish_job" style="labelBackgroundColor=#f5f5f5;endArrow=block;html=1;strokeColor=#666666;fontColor=#333333;fontFamily=Noto Sans CJK SC;fontSize=10;" edge="1" parent="1" source="running" target="done"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="重试" style="labelBackgroundColor=#f5f5f5;endArrow=block;html=1;strokeColor=#666666;fontColor=#333333;fontFamily=Noto Sans CJK SC;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="running" target="pending"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="275" y="165"/><mxPoint x="85" y="165"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="耗尽 / 永久错误" style="labelBackgroundColor=#f5f5f5;endArrow=block;html=1;strokeColor=#666666;fontColor=#333333;fontFamily=Noto Sans CJK SC;fontSize=10;" edge="1" parent="1" source="running" target="failed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="文档被删除" style="labelBackgroundColor=#f5f5f5;endArrow=block;html=1;strokeColor=#666666;fontColor=#333333;fontFamily=Noto Sans CJK SC;fontSize=10;" edge="1" parent="1" source="pending" target="cancelled"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="docLabel" value="文档状态（documents.status）" style="fillColor=#f5f5f5;text;html=1;fontStyle=1;fontColor=#333333;fontFamily=Noto Sans CJK SC;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="270" width="250" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="working" value="pending / parsing / chunking / embedding&lt;br&gt;中间态：worker 还在干活" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="30" y="310" width="250" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ready" value="ready&lt;br&gt;页级点齐 / 文本腿完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="380" y="300" width="170" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="docfailed" value="failed&lt;br&gt;任务失败或点数不足" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="380" y="380" width="170" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="guard" value="三个守卫：&lt;br&gt;① 只动中间态&lt;br&gt;② 没有未完成 ingest / embed_visual&lt;br&gt;③ 页级点数 ≥ len(scan_pages)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Noto Sans CJK SC;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="300" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="labelBackgroundColor=#f5f5f5;endArrow=block;html=1;strokeColor=#666666;" edge="1" parent="1" source="working" target="ready"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="labelBackgroundColor=#f5f5f5;endArrow=block;html=1;strokeColor=#666666;" edge="1" parent="1" source="working" target="docfailed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="labelBackgroundColor=#f5f5f5;endArrow=block;html=1;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="guard" target="ready"><mxGeometry relative="1" as="geometry"/></mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

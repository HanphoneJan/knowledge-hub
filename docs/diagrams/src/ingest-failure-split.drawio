<mxfile host="drawio" agent="doc-writing" version="24.7.17"><diagram id="ingest-failure-split" name="ingest-failure-split"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="摄取失败：永久错误一次终态，瞬时错误最多重试 3 次" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=17;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1020" height="30" as="geometry"/></mxCell><mxCell id="c2" value="IngestError.retryable 决定去向；文档状态由 doc_state 统一结算" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="42" width="1020" height="22" as="geometry"/></mxCell><mxCell id="c3" value="任务抛异常" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="80" width="300" height="50" as="geometry"/></mxCell><mxCell id="c4" value="retryable 且&lt;br&gt;attempts &lt; max_attempts？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="170" width="340" height="80" as="geometry"/></mxCell><mxCell id="c5" value="瞬时错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="330" height="60" as="geometry"/></mxCell><mxCell id="c6" value="永久错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="320" width="330" height="60" as="geometry"/></mxCell><mxCell id="c7" value="网络抖动 / 向量库暂不可用&lt;br&gt;Office 转换失败（可重试）&lt;br&gt;视觉写侧远端 503 / 超时&lt;br&gt;&lt;br&gt;→ 回 pending，等待下次领取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="410" height="150" as="geometry"/></mxCell><mxCell id="c8" value="格式不支持 · blob 缺失 · 解析为空&lt;br&gt;超过 2000 页 / 扫描件超过 50 页&lt;br&gt;页级任务页码越界 · LibreOffice 未安装&lt;br&gt;&lt;br&gt;→ 第一次就 failed，不占重试额度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="420" width="410" height="150" as="geometry"/></mxCell><mxCell id="c9" value="done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="620" width="200" height="50" as="geometry"/></mxCell><mxCell id="c10" value="failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="620" width="200" height="50" as="geometry"/></mxCell><mxCell id="c11" value="注意&lt;br&gt;&lt;br&gt;Office 预览失败只标任务失败，不动文档状态。预览是增强，不是摄取。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="150" height="150" as="geometry"/></mxCell><mxCell id="c12" value="重试耗尽&lt;br&gt;→ failed" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="90" height="70" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1
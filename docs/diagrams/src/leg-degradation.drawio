<mxfile host="drawio" agent="doc-writing" version="24.7.17"><diagram id="leg-degradation" name="leg-degradation"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="每条腿的跳过条件与对外表现" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=17;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1060" height="30" as="geometry"/></mxCell><mxCell id="c2" value="skipped 字符串 = 没跑；skipped=null 且 hits=[] = 跑了但零命中" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="42" width="1060" height="22" as="geometry"/></mxCell><mxCell id="c3" value="dense" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="160" height="90" as="geometry"/></mxCell><mxCell id="c4" value="索引模型 ≠ 当前配置&lt;br&gt;编码/网络异常" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="95" width="330" height="90" as="geometry"/></mxCell><mxCell id="c5" value="skipped：说明哪个模型不一致，给出改配置或重建的修法" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="95" width="500" height="90" as="geometry"/></mxCell><mxCell id="c6" value="sparse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="160" height="90" as="geometry"/></mxCell><mxCell id="c7" value="分词后没有任何 token&lt;br&gt;（全停用词/纯符号）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="215" width="330" height="90" as="geometry"/></mxCell><mxCell id="c8" value="skipped：查询词全不在词表；这不是错误，只是少一路候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="215" width="500" height="90" as="geometry"/></mxCell><mxCell id="c9" value="trgm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="335" width="160" height="90" as="geometry"/></mxCell><mxCell id="c10" value="query &lt; 3 字&lt;br&gt;语句超过 800ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="335" width="330" height="90" as="geometry"/></mxCell><mxCell id="c11" value="skipped：短 query 三 gram 无可比；超时提示调大阈值或换物化/外部引擎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="335" width="500" height="90" as="geometry"/></mxCell><mxCell id="c12" value="visual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="160" height="90" as="geometry"/></mxCell><mxCell id="c13" value="服务未配置/未起/模型未就绪&lt;br&gt;编码超 2s 或排队超时" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="455" width="330" height="90" as="geometry"/></mxCell><mxCell id="c14" value="skipped：说清是未配置、连不上还是模型未加载；文本三腿照常返回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="455" width="500" height="90" as="geometry"/></mxCell><mxCell id="c15" value="精排失败同理：保持原顺序 + skipped，不让检索 500。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="500" height="50" as="geometry"/></mxCell><mxCell id="c16" value="视觉腿在 API 进程不可用是正常状态（API 不加载 colSmol），不要写成“未启用”。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="590" width="510" height="50" as="geometry"/></mxCell><mxCell id="c17" value="检索整体仍然 200；其它腿照常参与 RRF。只有“所有腿都没跑且没命中”才是真的空结果。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="675" width="1030" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
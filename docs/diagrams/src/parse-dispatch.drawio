<mxfile host="drawio" agent="doc-writing" version="24.7.17"><diagram id="parse-dispatch" name="parse-dispatch"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="后缀如何分派到解析器" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=17;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1020" height="30" as="geometry"/></mxCell><mxCell id="c2" value="PARSERS 是唯一一份“支持哪些格式”的清单；白名单与图片集合都从它派生" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="42" width="1020" height="22" as="geometry"/></mxCell><mxCell id="c3" value="按 documents.file_name&lt;br&gt;后缀小写查 PARSERS" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="76" width="340" height="76" as="geometry"/></mxCell><mxCell id="c4" value="PDF&lt;br&gt;pymupdf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="220" width="230" height="70" as="geometry"/></mxCell><mxCell id="c5" value="DOCX / XLSX / PPTX&lt;br&gt;python-docx / openpyxl / python-pptx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="285" y="220" width="240" height="70" as="geometry"/></mxCell><mxCell id="c6" value="MD / TXT / JSON / CSV / HTML&lt;br&gt;读文本 + 标题/段落切" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="220" width="240" height="70" as="geometry"/></mxCell><mxCell id="c7" value="JPG / PNG / WEBP…&lt;br&gt;图片" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="815" y="220" width="220" height="70" as="geometry"/></mxCell><mxCell id="c8" value="PARSERS 未命中&lt;br&gt;415 UnsupportedFormat（同步拒绝）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="815" y="470" width="220" height="60" as="geometry"/></mxCell><mxCell id="c9" value="表格 + 段落&lt;br&gt;每个正文块 1 个框&lt;br&gt;表格每单元格 1 个框&lt;br&gt;产出 scan_pages / is_scanned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="230" height="115" as="geometry"/></mxCell><mxCell id="c10" value="按样式名还原标题层级&lt;br&gt;表格转 Markdown&lt;br&gt;无页坐标；Office 预览任务&lt;br&gt;在转换版上补坐标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="285" y="330" width="240" height="115" as="geometry"/></mxCell><mxCell id="c11" value="Markdown 标题 &gt; 段落 &gt; 硬切&lt;br&gt;GBK/GB18030/UTF-16 自动试&lt;br&gt;CSV/XLSX 首行当表头&lt;br&gt;HTML 不引入 bs4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="330" width="240" height="115" as="geometry"/></mxCell><mxCell id="c12" value="不产文本 chunk&lt;br&gt;scan_pages=[1]&lt;br&gt;直接进视觉路径&lt;br&gt;（可选出图片描述）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="815" y="330" width="220" height="115" as="geometry"/></mxCell><mxCell id="c13" value="派发表契约是三元组 (chunks, scan_pages, is_scanned)。只返回 list[Chunk] 的解析器由适配器补形状，并在注册时断言。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="720" height="80" as="geometry"/></mxCell><mxCell id="c14" value="扫描页判定：某页没有可用文本层 → 记 scan_pages；整份都没有 → is_scanned=true。空白页不算扫描页。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="1010" height="45" as="geometry"/></mxCell><mxCell id="c15" value="其它后缀直接拒绝，&lt;br&gt;不拖到 worker 才失败。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="815" y="560" width="220" height="55" as="geometry"/></mxCell><mxCell id="c16" value="pdf" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="office" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="text" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
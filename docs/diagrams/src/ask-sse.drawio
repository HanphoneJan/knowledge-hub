lor=#333333;strokeWidth=1.4;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="390" as="sourcePoint"/><mxPoint x="415" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="⑨ SSE: delta*" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;labelBackgroundColor=#ffffff;dashed=1;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="425" as="sourcePoint"/><mxPoint x="150" y="425" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="⑩ 生成结束 / 异常" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="460" as="sourcePoint"/><mxPoint x="415" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="⑪ parse_citations：合法 / 悬空" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;labelBackgroundColor=#ffffff;dashed=1;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="495" as="sourcePoint"/><mxPoint x="415" y="495" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="⑫ 新开 session_scope()，写 user + assistant" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="530" as="sourcePoint"/><mxPoint x="1175" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="⑬ 提交（两条一起）" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="565" as="sourcePoint"/><mxPoint x="415" y="565" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="⑭ SSE: done {citations, session_id, quality, legs}" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;labelBackgroundColor=#ffffff;dashed=1;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="600" as="sourcePoint"/><mxPoint x="150" y="600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="为什么流中不碰 DB&lt;br&gt;&lt;br&gt;FastAPI ≥0.106 在 yield 依赖上先执行退出码，再发送响应体；请求级 session 在第一个 SSE 帧之前就关闭了。流中 execute 会拿到未 await 的协程，消息静默丢失。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="470" height="95" as="geometry"/></mxCell><mxCell id="c28" value="失败处理&lt;br&gt;&lt;br&gt;外部生成器 401/超时/5xx → 降级抽取式，done.degraded 说明原因；证据质量 none 且非抽取式 → 直接拒答，不调模型。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="640" width="470" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>